rules_version = '2';

// tooc: profiles are readable by anyone signed in and writable by their owner; friend lists only by their owner;
// talks and their messages only by the people in them.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(toocID) {
      return signedIn() && get(/databases/$(database)/documents/users/$(toocID)).data.uid == request.auth.uid;
    }

    function memberOf(roomID) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/rooms/$(roomID)).data.memberUIDs;
    }

    match /users/{toocID} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /friends/{friendID} {
        allow read, write: if owns(toocID);
      }

      // Stickers made from your photos: yours only.
      match /stickers/{stickerID} {
        allow read, write: if owns(toocID);
      }

      // The linked email address, seen only by its owner.
      match /private/{docID} {
        allow read, write: if owns(toocID);
      }

      // Friend requests: written by the one who added, read and cleared by the one added.
      match /requests/{fromID} {
        allow read, delete: if owns(toocID) || owns(fromID);
        allow create, update: if owns(fromID);
      }
    }

    // Signing in with an email address: sha256(email) → toocID. Readable one at a time, never listed.
    match /emailIndex/{hash} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && owns(request.resource.data.toocID);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /rooms/{roomID} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberUIDs;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberUIDs;
      allow update: if signedIn() && request.auth.uid in resource.data.memberUIDs;
      allow delete: if signedIn() && resource.data.isMynote == true && request.auth.uid in resource.data.memberUIDs;

      match /messages/{messageID} {
        allow read: if memberOf(roomID);
        allow create: if memberOf(roomID) && request.resource.data.senderUID == request.auth.uid;
        allow update: if memberOf(roomID);
        allow delete: if memberOf(roomID) && resource.data.senderUID == request.auth.uid;
      }

      // ノート: posts with likes and comments; anyone in the talk reads, likes and comments, the author deletes.
      match /notes/{noteID} {
        allow read: if memberOf(roomID);
        allow create: if memberOf(roomID) && request.resource.data.authorUID == request.auth.uid;
        allow update: if memberOf(roomID);
        allow delete: if memberOf(roomID) && resource.data.authorUID == request.auth.uid;

        match /comments/{commentID} {
          allow read: if memberOf(roomID);
          allow create: if memberOf(roomID) && request.resource.data.authorUID == request.auth.uid;
          allow delete: if memberOf(roomID) && resource.data.authorUID == request.auth.uid;
        }
      }

      // アルバム: anyone in the talk adds photos; the one who made it deletes it.
      match /albums/{albumID} {
        allow read: if memberOf(roomID);
        allow create: if memberOf(roomID) && request.resource.data.authorUID == request.auth.uid;
        allow update: if memberOf(roomID);
        allow delete: if memberOf(roomID) && resource.data.authorUID == request.auth.uid;
      }
    }
  }
}
