rules_version = '2';

// tooc: profile photos are readable by anyone signed in and writable by their owner; photos and files in a talk
// only by the people in it. Uploads up to 50 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{toocID}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(toocID)).data.uid == request.auth.uid
        && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }

    match /rooms/{roomID}/{file=**} {
      allow read: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/rooms/$(roomID)).data.memberUIDs;
      allow write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/rooms/$(roomID)).data.memberUIDs
        && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }
  }
}
